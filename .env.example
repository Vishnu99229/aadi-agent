TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
GOOGLE_SHEET_ID=none
BRIEF_TIME=08:00
# claude is the only provider; /model can switch chat backends at runtime without changing this.
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Batched classification (follow-ups, bill scan). Haiku 5.5 is cheapest for JSON classification ($0.10/$0.50 per MTok up to 100K prompt).
BACKGROUND_MODEL=claude-haiku-5-5
BILL_SCAN_TIME=09:00
WEEKLY_REVIEW_TIME=19:00
PRE_MEETING_MINUTES=15,10,5
SKIP_INTERNAL_RECURRING=true
# openssl AES-256-CBC password for weekly /backup Telegram copies of aadi.db.
# Leave unset to skip Telegram backups. Store the value in your password manager;
# without it the .enc file cannot be opened. Never commit this.
BACKUP_PASSWORD=
# Google Gemini (OpenAI-compatible endpoint). Add GEMINI_API_KEY locally;
# Aadi never writes .env. Default model is gemini-1.5-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Optional. Google Cloud Vision OCR for photos (1,000 free DOCUMENT_TEXT_DETECTION
# requests/month). Leave empty to skip OCR and use the vision-LLM fallback.
GOOGLE_VISION_API_KEY=
# Optional. Vishnu fills this in locally — never write it from scripts.
# Official OpenAI-compatible base: https://api.deepseek.com
# Current model ids: deepseek-flash (default) and deepseek-v4-pro.
# Peak hours (2× price): 01:00–04:00 and 06:00–10:00 UTC, weekdays.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REASONER_MODEL=deepseek-flash
DEEPSEEK_INPUT_COST_PER_MILLION=0.15
DEEPSEEK_OUTPUT_COST_PER_MILLION=0.6
DEEPSEEK_CACHE_READ_COST_PER_MILLION=0.003
SARVAM_API_KEY=
# Spoken replies after the owner's own (non-forwarded) voice notes.
# Default false. /voice on|off toggles at runtime via settings.
VOICE_REPLIES_ENABLED=false
# Claude Sonnet 5.5 (chat, brief, documents) — USD per million tokens
LLM_INPUT_COST_PER_MILLION=2
LLM_OUTPUT_COST_PER_MILLION=10
LLM_CACHE_CREATION_COST_PER_MILLION=2.5
LLM_CACHE_READ_COST_PER_MILLION=0.1
# Claude Haiku 5.5 (background classification) — USD per million tokens
BACKGROUND_INPUT_COST_PER_MILLION=0.1
BACKGROUND_OUTPUT_COST_PER_MILLION=0.5
BACKGROUND_CACHE_CREATION_COST_PER_MILLION=0.125
BACKGROUND_CACHE_READ_COST_PER_MILLION=0.01
# Gemini 1.5 Flash — ai.google.dev/pricing
GEMINI_INPUT_COST_PER_MILLION=0.075
GEMINI_OUTPUT_COST_PER_MILLION=0.3
GEMINI_CACHE_CREATION_COST_PER_MILLION=0
GEMINI_CACHE_READ_COST_PER_MILLION=0
# Local Gemma (Ollama). Unused unless a call sets backend=local-gemma. Cost is 0.
# Never start Ollama on the phone while Aadi is running. Not in the boot script.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=gemma4:e4b
# Optional: /build launches Cursor cloud agents against this repo.
# Fine-grained GitHub token: aadi-agent only, contents + pull requests read/write.
CURSOR_API_KEY=
GITHUB_TOKEN=
# true: merge and deploy when CI passes and the PR does not touch protected areas.
# false: wait for a Deploy tap after checks, as before.
AUTO_DEPLOY=true
MEETING_TIMEZONE=Asia/Kolkata
MEETING_HOURS=10:00-18:30
MEETING_BREAK=13:00-14:00
MEETING_BUFFER_MINUTES=15
MEETING_DEFAULT_MINUTES=30
MEETING_SLOTS_TO_OFFER=3
MEETING_MIN_NOTICE_HOURS=4
MEETING_HORIZON_DAYS=7
MEETING_HOLDS_ON_PROPOSE=false
AUTO_BOOK=true
MEETING_MODE=auto
AUTO_BOOK_DELAY_MINUTES=10
AUTO_BOOK_DAILY_CAP=5
AUTO_SEND_DAILY_CAP=15
AUTO_BOOK_MIN_CONFIDENCE=0.85
# Comma-separated From addresses treated as external prospects (still skip the work address).
MEETING_TEST_SENDERS=
# Extra owner mailboxes. These are Vishnu for self-send protection, the same as the
# work and personal addresses already known in code. Comma-separated. Profile
# addresses and send-as aliases are added as well. Empty by default.
SELF_EMAIL_ADDRESSES=
# Domains that must never receive an automatic scheduling email.
# Defaults to supertroninfotech.com, supertronindia.com, pinnacle.in and shriramlife.com when unset.
# pinnacle.in is the From domain on Pinnacle Teleservices mail in the work inbox,
# and the email_domains value on that partner account.
PARTNER_DOMAINS=
# When on, send_email writes and sends what Vishnu tells it to, with no card and no
# content check, and send_immediately on the draft tools makes a Send card instead.
SEND_ON_COMMAND_ENABLED=false
# Outbound sales follow-up sequences. Off by default: no pitch cards and no sends.
SEQUENCES_ENABLED=false
# Days from the previous send to the next step.
SEQUENCE_STEP_DAYS=2
# Minimum classifier confidence before a "Start a sequence?" card appears.
SEQUENCE_PITCH_MIN_CONFIDENCE=0.75
# Most sequence emails in one IST day, and the minimum gap between two of them.
SEQUENCE_DAILY_SEND_CAP=15
SEQUENCE_MIN_SPACING_MINUTES=3
# Web search is model-independent. The model only decides WHETHER to search;
# code picks the provider in this order. DeepSeek Search reuses DEEPSEEK_API_KEY.
WEB_SEARCH_ORDER=deepseek,gemini,claude
# Optional pin: tried first, then the rest of WEB_SEARCH_ORDER.
# WEB_SEARCH_PROVIDER=deepseek
WEB_SEARCH_DAILY_CAP=100
# Gemini embedding backfill (message-embed). Kolkata-day token cap. Paid text
# price is $0.20 / 1M tokens, so 200000 is about $0.04/day.
EMBED_DAILY_TOKEN_CAP=200000
# Specialist agents (docs/MULTI_AGENT.md). full = direct answers, one-domain turns
# to that agent, and delegated workflows. fast = direct answers only. off = Aadi's
# own loop handles every turn (tools still run through their owning agent).
AGENT_ROUTING=full
# Independent goal loops inside delegate_tasks. Off unless set true. Named
# capabilities and the fast path keep working either way.
# AGENT_GOAL_DELEGATION=true
#
# ---- Models (src/models/registry.ts) ----
# Keys stay here, never in SQLite. A provider with no key is simply unavailable.
# OPENAI_API_KEY=
# KIMI_API_KEY=          (MOONSHOT_API_KEY also works)
# KIMI_BASE_URL=https://api.moonshot.ai/v1   (api.moonshot.cn inside China)
# Exact model ids are configurable because provider lists change. Check them
# against each provider's live list with: npm run live:models
# OPENAI_MODEL_STRONG=gpt-5.5
# OPENAI_MODEL_FAST=gpt-5.4-mini
# CLAUDE_OPUS_MODEL=claude-opus-5-5
# KIMI_MODEL=kimi-k2.6
# GEMINI_PRO_MODEL=            (adds gemini:pro when set)
# More models without a code change: provider/model-id[=Name][@1|2|3]
# MODELS_EXTRA=openai/gpt-6.1-sol=GPT-6.1 Sol@3,kimi/kimi-k3@3
# Cost estimates per million tokens (defaults in registry.ts), e.g.
# OPENAI_STRONG_INPUT_COST_PER_MILLION=1.25
# OPENAI_STRONG_OUTPUT_COST_PER_MILLION=10
# KIMI_INPUT_COST_PER_MILLION=0.6
# KIMI_OUTPUT_COST_PER_MILLION=2.5
#
# ---- Agent models (src/models/agent_models.ts) ----
# Each agent thinks with its own model on every path it reasons on. Telegram
# (/settings -> Agent models) overrides this, and this overrides the built-in
# experiment defaults. Format: agent=primary[>fallback...][@light|standard|deep],
# "auto" for the primary or the fallbacks. Model keys: openai:strong,
# openai:fast, anthropic:opus, anthropic:sonnet, anthropic:haiku, gemini:flash,
# gemini:pro, deepseek:flash, deepseek:reasoner, kimi:main.
# AGENT_MODELS=aadi=openai:strong>gemini:flash@light,email=openai:fast>gemini:flash,calendar=gemini:flash>openai:fast,sales=anthropic:sonnet>openai:strong@standard,knowledge=kimi:main>gemini:flash@standard,operations=deepseek:flash>openai:fast,build=openai:strong>anthropic:sonnet@standard
# Older setting, now that agent's default for every path (not only goals):
# AGENT_GOAL_AGENT_BACKENDS=knowledge=haiku
# AGENT_GOAL_MAX_CONCURRENT=2
# AGENT_GOAL_MAX_DEPTH=1
# AGENT_GOAL_MAX_ITERATIONS=6
# AGENT_GOAL_MAX_MODEL_CALLS=16
# AGENT_GOAL_TIMEOUT_SECONDS=240
# Ordinary caps. A thorough research job, a deep dive, or a large job uses the
# higher caps. The goal's own wording cannot raise them.
# AGENT_GOAL_WORKFLOW_BUDGET_USD=0.05
# AGENT_GOAL_BUDGET_USD=0.02
# AGENT_GOAL_LARGE_WORKFLOW_BUDGET_USD=0.50
# AGENT_GOAL_LARGE_GOAL_BUDGET_USD=0.20
# A2A (Agent2Agent 1.0, HTTP+JSON with SSE). Off by default. The endpoint listens
# on 127.0.0.1 only and every request, the agent card included, needs a bearer
# credential (24+ characters). It offers other agents knowledge.web_search,
# knowledge.latest_release and system.a2a_test only. Reach it from another
# machine through Tailscale or an SSH tunnel, never by opening the port.
A2A_SERVER_ENABLED=false
# A2A_SERVER_PORT=41241
# One credential per calling agent (preferred):
# A2A_SERVER_CLIENTS=vm
# A2A_CLIENT_VM_TOKEN=
# Or one shared credential, logged as client "default":
# A2A_SERVER_TOKEN=
# The address callers use, advertised on the agent card (https, or http on loopback):
# A2A_PUBLIC_URL=https://phone.tailnet-name.ts.net
# Push notifications: only to these callback origins. Empty: push is not offered.
# A2A_PUSH_ALLOWED_ORIGINS=https://vm.tailnet-name.ts.net
# Where remote agents can push updates for Aadi's own long tasks (Aadi's A2A URL).
# A2A_PUSH_CALLBACK_URL=https://phone.tailnet-name.ts.net
# Remote agents Aadi may use: comma-separated id=url, https or http on loopback.
# Each one's token goes in A2A_REMOTE_<ID>_TOKEN. Nothing else is ever contacted.
# A2A_REMOTE_AGENTS=quotes=http://127.0.0.1:41250
# A2A_REMOTE_QUOTES_TOKEN=
