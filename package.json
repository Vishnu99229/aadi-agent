    "test:security": "AADI_DB_PATH=:memory: tsx scripts/test-security.ts",
    "test:stage5": "tsx scripts/test-stage5.ts",
    "test:stage6": "tsx scripts/test-stage6.ts",
    "test:stage7": "tsx scripts/test-stage7.ts",
    "test:stage8": "tsx scripts/test-stage8.ts",
    "test:stage10": "tsx scripts/test-stage10.ts",
    "test:memory": "tsx scripts/test-memory.ts",
    "test:usage": "tsx scripts/test-usage.ts",
    "prefix-size": "tsx --env-file=.env scripts/prefix-size.ts",
    "live:haiku": "tsx --env-file=.env scripts/test-haiku-background-live.ts",
    "live:documents": "tsx --env-file=.env scripts/test-document-analysis.ts",
    "test:stage11": "tsx scripts/test-stage11.ts",
    "test:start-greeting": "tsx scripts/test-start-greeting.ts",
    "bench:models": "tsx --env-file=.env scripts/bench-models.ts"
  },
