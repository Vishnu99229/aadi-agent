    "google:auth:work": "tsx src/google/authorize.ts --work",
    "google:test": "tsx src/google/test.ts",
    "test": "npm run test:stage5 && npm run test:stage6 && npm run test:stage7 && npm run test:stage8 && npm run test:stage10 && npm run test:memory && npm run test:usage && npm run test:stage11 && npm run test:security && npm run test:stage12 && npm run test:start-greeting && npm run test:phone-mirroring",
