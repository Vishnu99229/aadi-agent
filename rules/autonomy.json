{
  "comment": "Decision rules that run against every outgoing draft BEFORE it reaches the Telegram approval card. One event per fired rule. The approvals layer orders events by priority: require_manual_approval always wins over auto_send_approved.",
  "rules": [
    {
      "name": "block-auto-send-to-new-domains",
      "priority": 100,
      "conditions": {
        "any": [
          {
            "fact": "domain_seen_count",
            "operator": "lessThan",
            "value": 2
          }
        ]
      },
      "event": {
        "type": "require_manual_approval",
        "params": {
          "reason": "Recipient domain has been seen less than twice before - manual tap required.",
          "rule": "block-auto-send-to-new-domains"
        }
      }
    },
    {
      "name": "auto-approve-known-client-text-replies",
      "priority": 50,
      "conditions": {
        "all": [
          { "fact": "is_known_client", "operator": "equal", "value": true },
          { "fact": "has_attachment", "operator": "equal", "value": false },
          { "fact": "domain_seen_count", "operator": "greaterThanInclusive", "value": 2 }
        ]
      },
      "event": {
        "type": "auto_send_approved",
        "params": {
          "reason": "Known client, no attachment, established domain - 5-minute cancel window applies.",
          "rule": "auto-approve-known-client-text-replies",
          "cancelWindowMinutes": 5
        }
      }
    }
  ]
}
